---
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
}

const { title, description = "Muusica.com - Música legal para tu negocio. Playlists curadas profesionalmente para crear el ambiente perfecto.", type = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// JSON-LD global: Organization + WebSite (SEO/GEO)
const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Muusica.com',
    url: 'https://muusica.com',
    logo: 'https://muusica.com/logo.svg',
    description: 'Música legal para negocios en México: streaming con licencia comercial incluida, sin regalías de SACM ni SOMEXFON.',
    sameAs: ['https://play.muusica.com'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Muusica.com',
    url: 'https://muusica.com',
    inLanguage: 'es-MX',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Muusica.com" />
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <slot name="head" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-bg-page overflow-x-hidden">
    <slot />
    <CookieBanner />

    <script>
      // Initialize Lucide icons
      document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) {
          window.lucide.createIcons();
        }
      });
      
      // Intersection Observer for reveal animations
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
      };
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, observerOptions);
      
      document.addEventListener('DOMContentLoaded', () => {
        const revealElements = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale');
        revealElements.forEach(el => observer.observe(el));
      });
      
      // Al llegar con "/#ancla" desde otra página, el navegador salta al destino
      // antes de que terminen de cargar fuentes e imágenes del home. Como eso
      // mueve el layout, el salto se pierde y la página queda arriba. Volvemos a
      // colocarla cuando ya está estable, salvo que el usuario haya scrolleado.
      (() => {
        if (!window.location.hash) return;

        let usuarioScrolleo = false;
        const marcar = () => { usuarioScrolleo = true; };
        ['wheel', 'touchstart', 'keydown'].forEach((ev) =>
          window.addEventListener(ev, marcar, { once: true, passive: true })
        );

        const colocar = () => {
          if (usuarioScrolleo) return;
          let target = null;
          try { target = document.querySelector(window.location.hash); } catch { return; }
          if (target) target.scrollIntoView({ block: 'start' });
        };

        // Reintentamos durante el arranque en vez de confiar en un solo evento:
        // las fuentes y las imágenes del hero cambian la altura de la página
        // varias veces y cada una desplaza el destino.
        const inicio = Date.now();
        const reintento = setInterval(() => {
          colocar();
          if (usuarioScrolleo || Date.now() - inicio > 2000) clearInterval(reintento);
        }, 100);

        colocar();
        window.addEventListener('load', colocar);
        window.addEventListener('pageshow', colocar); // volver atrás desde bfcache
        if (document.fonts?.ready) document.fonts.ready.then(colocar);
      })();

      // Scroll suave sólo para anclas que existen EN ESTA página.
      //
      // Los enlaces a secciones del home se escriben "/#legal" (no "#legal"),
      // porque el header y el footer salen en todas las páginas y un "#legal"
      // suelto no lleva a ningún lado desde /blog o /alternativas. Este handler
      // resuelve el href completo: si apunta a la página actual y el destino
      // existe, hace scroll suave; si no, no intercepta y el navegador navega
      // normalmente. Antes se hacía preventDefault siempre, así que un ancla
      // inexistente dejaba el enlace muerto.
      document.addEventListener('click', (e) => {
        const el = e.target instanceof Element ? e.target.closest('a[href*="#"]') : null;
        if (!el || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;

        const url = new URL(el.getAttribute('href'), window.location.href);
        if (url.origin !== window.location.origin) return;
        if (url.pathname !== window.location.pathname) return; // otra página: que navegue
        if (!url.hash || url.hash === '#') return;

        const target = document.querySelector(url.hash);
        if (!target) return; // sin destino en esta página: no lo interceptamos

        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.pushState(null, '', url.hash);
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

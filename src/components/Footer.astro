---
import CertificateModal from './CertificateModal.astro';
import WaveMark from './WaveMark.astro';
const currentYear = new Date().getFullYear();
// Navegación mínima: el header es fijo y ya lleva el resto de las secciones,
// así que aquí sólo van las páginas que no viven en el home.
const navigationLinks = [
  { label: "Inicio", href: "/" },
  { label: "Blog", href: "/blog" },
  { label: "Alternativas", href: "/alternativas" },
];

// Los anclas van con "/#" y no con "#": el footer se renderiza en todas las
// páginas, y un "#legal" suelto no lleva a ningún lado desde /blog o /terminos.
const legalLinks = [
  { label: "Uso comercial permitido", href: "/#beneficios" },
  { label: "Sin regalías", href: "/#legal" },
  { label: "Certificado incluido", href: "/#legal" },
];

const bottomLinks = [
  { label: "Términos", href: "/terminos" },
  { label: "Privacidad", href: "/aviso-de-privacidad" },
  { label: "Contacto", href: "mailto:hola@muusica.com" },
];
---

<footer class="py-16 px-8 md:px-16" style="background: linear-gradient(180deg, #0A0A15 0%, #050508 100%);">
  <div class="max-w-[1440px] mx-auto">
    <!-- Top section -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <!-- Brand column -->
      <div>
        <a href="/" class="inline-block mb-4">
          <img src="/logo.svg" alt="Muusica.com" class="h-7 w-auto" />
        </a>
        <p class="text-text-secondary text-sm mb-6">
          Música legal para negocios.
        </p>
      </div>
      
      <!-- Navigation column -->
      <div>
        <h3 class="text-white font-semibold mb-4">Navegación</h3>
        <ul class="space-y-3">
          {navigationLinks.map((link) => (
            <li>
              <a href={link.href} class="text-text-secondary text-sm hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Legal column -->
      <div>
        <h3 class="text-white font-semibold mb-4">Legal</h3>
        <ul class="space-y-3">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-text-secondary text-sm hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <button
          data-cert-trigger
          class="text-primary-teal text-sm font-medium hover:underline flex items-center gap-2 transition-colors mt-3"
        >
          <i data-lucide="external-link" class="w-4 h-4"></i>
          Ver ejemplo del certificado
        </button>
      </div>
      
      <!-- CTA column -->
      <div>
        <h3 class="text-white font-semibold mb-4">¿Listo para empezar?</h3>
        <a href="https://play.muusica.com" class="btn-primary text-sm inline-flex mb-4">
          Probar gratis
        </a>
        <div class="space-y-2 text-sm">
          <!--email_off--><a href="mailto:hola@muusica.com" class="text-text-secondary hover:text-white transition-colors flex items-center gap-2">
            <i data-lucide="mail" class="w-4 h-4"></i>
            hola@muusica.com
          </a><!--email_on-->
        </div>
      </div>
    </div>
    
    <!-- Divisor: en vez de una línea, las "uu" del logo hechas onda -->
    <WaveMark height="22px" opacity={0.14} animate class="mb-8" />
    
    <!-- Bottom section -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-text-tertiary text-sm">
        © {currentYear} Muusica.com
      </p>
      <div class="flex items-center gap-6">
        <!--email_off-->{bottomLinks.map((link) => (
          <a href={link.href} class="text-text-tertiary text-sm hover:text-white transition-colors">
            {link.label}
          </a>
        ))}<!--email_on-->
      </div>
    </div>
  </div>
</footer>

<CertificateModal />

---
// Home: lo último de /novedades (timeline) + playlists recién llegadas con muestra.
// Distinto a Blog.astro a propósito: panel con lista y reproductor, no tarjetas con imagen.
import { getCollection } from 'astro:content';
import PlaylistSamples from './blog/PlaylistSamples.astro';

const posts = (await getCollection('novedades'))
  .filter(p => p.data.date.valueOf() <= Date.now())
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const ultimas = posts.filter(p => p.data.category !== 'Playlists').slice(0, 5);
const temas = posts.filter(p => p.data.category === 'Playlists').slice(0, 3);
// ponytail: lista fija de las playlists más recientes del catálogo; actualizar al publicar playlists nuevas
const nuevas = ['son-jarocho', 'trova-yucateca', 'navidad-jazz-lounge', 'posadas-y-ponche', 'pan-caliente', 'barberia-clasica'];
const icon = { Novedades: 'sparkles', 'Guías': 'book-open' };
---

<section id="novedades" class="section">
  <div class="max-w-[1440px] mx-auto">
    <div class="reveal rounded-[2rem] border border-white/10 p-6 sm:p-10 lg:p-12 overflow-hidden"
      style="background: radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--primary-purple) 22%, transparent), transparent 60%), radial-gradient(100% 80% at 100% 100%, color-mix(in srgb, var(--primary-teal) 18%, transparent), transparent 60%), rgba(255,255,255,0.02);">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
        <div>
          <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-primary-teal bg-white/5 border border-white/10 rounded-full px-3 py-1 mb-4">
            <span class="w-2 h-2 rounded-full bg-primary-teal animate-pulse"></span> Novedades
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-white">Lo nuevo en Muusica.com</h2>
          <p class="text-text-secondary mt-2 max-w-xl">Funciones recién lanzadas, guías rápidas y la música que acaba de llegar al catálogo.</p>
        </div>
        <a href="/novedades" class="btn-ghost inline-flex items-center gap-2 self-start md:self-auto">
          Ver todas las novedades <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
      </div>

      <div class="grid lg:grid-cols-2 gap-10">
        <div class="min-w-0">
          <h3 class="text-white font-semibold mb-4 flex items-center gap-2"><i data-lucide="rocket" class="w-4 h-4 text-primary-teal"></i> Funciones y guías</h3>
          <ol class="relative border-l border-white/10 ml-2">
            {ultimas.map((p) => (
              <li class="ml-6 mb-6 last:mb-0 min-w-0">
                <span class="absolute -left-[9px] mt-1.5 w-4 h-4 rounded-full bg-black border-2 border-primary-teal"></span>
                <a href={`/novedades/${p.slug}`} class="group block">
                  <div class="flex items-center gap-2 text-xs text-text-tertiary mb-1">
                    <i data-lucide={icon[p.data.category] ?? 'sparkles'} class="w-3.5 h-3.5"></i>
                    <span>{p.data.category}</span><span>·</span><span>{p.data.dateFormatted}</span>
                  </div>
                  <p class="text-white font-semibold leading-snug group-hover:text-primary-teal transition-colors">{p.data.title}</p>
                </a>
              </li>
            ))}
          </ol>
        </div>

        <div class="min-w-0">
          <h3 class="text-white font-semibold flex items-center gap-2 -mb-6"><i data-lucide="music-2" class="w-4 h-4 text-primary-teal"></i> Playlists recién llegadas</h3>
          <PlaylistSamples items={nuevas} title="Dale play a una muestra" />
          <div class="flex flex-wrap gap-2 -mt-4">
            {temas.map((p) => (
              <a href={`/novedades/${p.slug}`} class="chip chip-inactive text-sm">{p.data.title.split(':')[0]}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

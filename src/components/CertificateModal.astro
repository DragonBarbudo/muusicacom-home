---
// Vista previa del "Comprobante de Licencia Comercial".
// Réplica del PDF real que emite Muusica.com: doble marco (teal por fuera, azul
// fino por dentro), logo centrado, datos del establecimiento, dos párrafos de
// certificación, caja de folio/fecha/vigencia, QR de validación y firma.
// Si cambia el PDF real, este componente debe seguirlo.
interface Props {
  businessName?: string;
  address?: string;
}

const {
  businessName = 'Café Aurora Sucursal Centro',
  address = 'Av. Benito Juárez 1234, Col. Centro, Guadalajara, Jalisco, C.P. 44100',
} = Astro.props;

// Folio y fecha se generan al construir el sitio (hay rebuild diario), así que
// el ejemplo nunca aparece con una fecha vieja.
const hoy = new Date();
const meses = [
  'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
  'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre',
];
const fechaEmision = `${hoy.getDate()} de ${meses[hoy.getMonth()]} de ${hoy.getFullYear()}`;
const compacta = `${hoy.getFullYear()}${String(hoy.getMonth() + 1).padStart(2, '0')}${String(hoy.getDate()).padStart(2, '0')}`;
const folio = `MU-12345678-${compacta}`;

const datos = [
  { label: 'Folio', valor: folio },
  { label: 'Fecha de emisión', valor: fechaEmision },
  { label: 'Vigencia', valor: 'Vigente mientras la suscripción permanezca activa' },
];
---

<!-- Certificate Modal Overlay (lo abren los botones [data-cert-trigger]: footer y sección Legal) -->
<div id="certModalOverlay" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-300">
  <div class="min-h-screen flex items-center justify-center p-4">

    <div id="certPreviewModal" class="bg-bg-surface border border-white/10 rounded-2xl shadow-2xl max-w-4xl w-full overflow-hidden">
      <!-- Header -->
      <div class="p-4 border-b border-white/10 flex items-center justify-between bg-white/[0.02]">
        <div class="flex items-center gap-3">
          <i data-lucide="file-text" class="w-5 h-5 text-primary-teal"></i>
          <span class="text-white font-medium">Vista previa del certificado</span>
          <span class="px-2 py-0.5 rounded-full bg-yellow-500/20 text-yellow-400 text-xs font-medium">
            Ejemplo
          </span>
        </div>
        <button id="closePreviewBtn" class="p-2 rounded-lg hover:bg-white/10 transition-colors text-text-secondary hover:text-white" aria-label="Cerrar">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Documento -->
      <div class="p-4 sm:p-8 bg-[#0A0A12] overflow-auto max-h-[70vh]">
        <!-- Marco exterior teal + marco interior azul, como en el PDF -->
        <div id="certificatePdf" class="bg-white mx-auto max-w-[700px] text-[#1F2937] shadow-2xl" style="border: 4px solid #17B8A6;">
          <div class="h-full" style="border: 1px solid #2B4B8F; margin: 6px;">
            <div class="px-6 sm:px-12 py-10 text-center">

              <!-- Logo -->
              <img src="/logo-light.svg" alt="Muusica.com" width="242" height="48" loading="lazy" class="h-9 sm:h-11 w-auto mx-auto mb-14" />

              <!-- Título -->
              <!-- whitespace-nowrap desde sm: en el PDF real el título va en una sola línea -->
              <!-- No es un encabezado de la página: es el título dentro del facsímil del
                   certificado. Como h1 duplicaba el H1 real en todas las páginas. -->
              <p class="text-xl sm:text-[30px] sm:whitespace-nowrap font-normal leading-tight text-[#1F2937] mb-3">
                Comprobante de Licencia Comercial
              </p>
              <p class="text-[11px] sm:text-xs text-[#6B7280]">
                Música legal para tu negocio · muusica.com
              </p>
              <div class="w-40 h-px mx-auto my-7" style="background: #17B8A6;"></div>

              <!-- Establecimiento -->
              <p class="text-[11px] sm:text-xs text-[#6B7280] mb-2">Se otorga a</p>
              <p class="text-xl sm:text-[26px] font-normal leading-snug mb-5" style="color: #17B8A6;">
                {businessName}
              </p>
              <p class="text-[10px] sm:text-[11px] text-[#6B7280] mb-1">Establecimiento ubicado en</p>
              <p class="text-xs sm:text-[13px] text-[#374151]">{address}</p>

              <!-- Cuerpo -->
              <div class="max-w-[92%] mx-auto mt-9 space-y-5 text-[11.5px] sm:text-[12.5px] leading-[1.75] text-[#374151]">
                <p>
                  Por medio del presente, Muusica.com certifica que el establecimiento arriba
                  mencionado cuenta con una licencia vigente para la reproducción pública, dentro
                  de dicha sucursal, de la música disponible en el catálogo de Muusica.com.
                </p>
                <p>
                  Toda la música del catálogo de Muusica.com es original y libre de regalías, por lo
                  que su reproducción en el establecimiento no requiere pagos adicionales por
                  derechos de autor ni derechos conexos.
                </p>
              </div>

              <!-- Folio, fecha y vigencia -->
              <dl
                class="mt-9 rounded-xl px-5 sm:px-7 py-5 text-left space-y-2.5"
                style="border: 1px solid #A7E5DC; background: #F4FBFA;"
              >
                {datos.map((d) => (
                  <div class="flex flex-col sm:flex-row sm:items-baseline gap-0.5 sm:gap-4">
                    <dt class="text-[9.5px] sm:text-[10px] uppercase tracking-wider flex-shrink-0 sm:w-[130px]" style="color: #5F9E97;">
                      {d.label}
                    </dt>
                    <dd class="text-[11.5px] sm:text-[12.5px] text-[#374151]">{d.valor}</dd>
                  </div>
                ))}
              </dl>

              <!-- QR + firma -->
              <div class="mt-9 flex items-end justify-between gap-6 text-left">
                <div class="flex-shrink-0 w-[104px]">
                  <img src="/certificado-qr.svg" alt="Código QR de validación" class="w-[104px] h-[104px]" />
                  <p class="text-[8.5px] leading-snug text-[#6B7280] text-center mt-1.5">
                    Escanea para validar la vigencia del certificado
                  </p>
                </div>

                <div class="flex-1 max-w-[260px] text-center pb-6">
                  <div class="h-px w-full mb-2" style="background: #9CA3AF;"></div>
                  <p class="text-[12px] sm:text-[13px] text-[#374151]">Muusica.com</p>
                  <p class="text-[9.5px] sm:text-[10px] text-[#6B7280] mt-0.5">
                    Autorización de licencia comercial
                  </p>
                </div>
              </div>

              <!-- Pie legal -->
              <p class="mt-8 text-[8px] sm:text-[8.5px] leading-relaxed text-[#9CA3AF]">
                Documento generado automáticamente. Válido únicamente mientras la cuenta asociada
                mantenga una suscripción o prueba vigente. Verifica el estatus escaneando el código
                QR o en play.muusica.com.
              </p>

            </div>
          </div>
        </div>
      </div>

      <!-- Aviso de que es un ejemplo -->
      <div class="p-4 bg-yellow-500/10 border-t border-yellow-500/20">
        <div class="flex items-center justify-center gap-2 text-yellow-400 text-sm text-center">
          <i data-lucide="info" class="w-4 h-4 flex-shrink-0"></i>
          <span>Este es un ejemplo con datos ficticios. El certificado real se genera al activar tu suscripción.</span>
        </div>
      </div>
    </div>

  </div>
</div>

<script is:inline>
  (function() {
    const overlay = document.getElementById('certModalOverlay');
    const closePreviewBtn = document.getElementById('closePreviewBtn');

    // Cualquier elemento [data-cert-trigger] abre el modal (footer, sección Legal, etc.)
    document.querySelectorAll('[data-cert-trigger]').forEach((btn) => {
      btn.addEventListener('click', () => {
        overlay.classList.remove('hidden');
        setTimeout(() => {
          overlay.classList.remove('opacity-0');
        }, 10);
      });
    });

    function closeModal() {
      overlay.classList.add('opacity-0');
      setTimeout(() => {
        overlay.classList.add('hidden');
      }, 300);
    }

    closePreviewBtn?.addEventListener('click', closeModal);
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
        closeModal();
      }
    });
  })();
</script>

---
// Separador entre secciones. Cuatro tipos, para que la página no repita el mismo
// recurso doce veces:
//
//   onda       las "uu" del logo a sangre completa (el separador base)
//   particulas las "uu" pequeñas con puntos flotando alrededor
//   linea      un trazo tipo forma de onda, con un destello que lo recorre
//   pulso      las "uu" con un resplandor detrás, como un golpe de graves
//
// Todos aceptan alto, color, opacidad, dirección y espaciado propios: la idea es
// que ninguno sea idéntico al anterior. El movimiento se apaga con
// prefers-reduced-motion.

interface Props {
  tipo?: 'onda' | 'particulas' | 'linea' | 'pulso';
  height?: string;
  /** Hex sin "#". Por defecto el teal de marca. */
  color?: string;
  opacity?: number;
  direction?: 'left' | 'right';
  speed?: number;
  /** Espaciado vertical (clase de Tailwind). */
  space?: string;
  /** Semilla para que las partículas no se repitan entre separadores. */
  seed?: number;
  class?: string;
}

import WaveMark from './WaveMark.astro';

const {
  tipo = 'onda',
  height = '54px',
  color = '14B8A6',
  opacity = 0.12,
  direction = 'left',
  speed = 26,
  space = 'py-10',
  seed = 1,
  class: className = '',
} = Astro.props;

// Pseudoaleatorio determinista: mismo resultado en cada build, distinto por separador
const rnd = (n: number) => {
  const x = Math.sin(seed * 99.7 + n * 37.13) * 10000;
  return x - Math.floor(x);
};

// ── partículas ────────────────────────────────────────────────────────────
const particulas = Array.from({ length: 22 }, (_, i) => ({
  left: (rnd(i) * 100).toFixed(2),
  top: (12 + rnd(i + 50) * 76).toFixed(2),
  size: (2.5 + rnd(i + 100) * 4).toFixed(1),
  delay: (rnd(i + 150) * 9).toFixed(2),
  dur: (7 + rnd(i + 200) * 8).toFixed(2),
  op: (0.45 + rnd(i + 250) * 0.5).toFixed(2),
}));

// ── trazo tipo forma de onda ──────────────────────────────────────────────
// Suma de senos con distinta frecuencia: se parece a una envolvente de audio
// sin ser una sinusoide perfecta.
const W = 1200;
const H = 80;
const puntos: string[] = [];
for (let x = 0; x <= W; x += 6) {
  const t = (x / W) * Math.PI * 2;
  const y =
    H / 2 +
    Math.sin(t * 3 + seed) * (H * 0.3) +
    Math.sin(t * 7.3 + seed * 2) * (H * 0.14) +
    Math.sin(t * 13.1 + seed * 3) * (H * 0.06);
  puntos.push(`${x},${y.toFixed(2)}`);
}
const pathLinea = `M${puntos.join(' L')}`;
const gradId = `wd-grad-${seed}`;
---

<div class:list={['relative w-full overflow-hidden', space, className]} aria-hidden="true">
  {tipo === 'onda' && (
    <WaveMark height={height} color={color} opacity={opacity} animate direction={direction} speed={speed} fade={false} />
  )}

  {tipo === 'pulso' && (
    <div class="relative">
      <div
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[70%] max-w-[900px] rounded-full blur-[80px] wd-latido"
        style={`height: ${height}; background: #${color}; opacity: .3;`}
      >
      </div>
      <WaveMark
        height={height}
        color={color}
        opacity={opacity}
        animate
        direction={direction}
        speed={speed}
        fade={false}
        class="relative"
      />
    </div>
  )}

  {tipo === 'particulas' && (
    <div class="relative">
      <WaveMark height={height} color={color} opacity={opacity} animate direction={direction} speed={speed} fade={false} />
      <div class="absolute inset-x-0 -inset-y-6 pointer-events-none">
        {particulas.map((p) => (
          <span
            class="wd-particula absolute rounded-full"
            style={`left:${p.left}%; top:${p.top}%; width:${p.size}px; height:${p.size}px; background:#${color}; opacity:${p.op}; box-shadow: 0 0 ${p.size}px #${color}; animation-delay:-${p.delay}s; animation-duration:${p.dur}s;`}
          ></span>
        ))}
      </div>
    </div>
  )}

  {tipo === 'linea' && (
    <svg
      class="w-full block"
      style={`height: ${height}`}
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="none"
      role="presentation"
    >
      <defs>
        <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color={`#${color}`} stop-opacity="0" />
          <stop offset="18%" stop-color={`#${color}`} stop-opacity={opacity * 2.6} />
          <stop offset="50%" stop-color={`#${color}`} stop-opacity={opacity * 5} />
          <stop offset="82%" stop-color={`#${color}`} stop-opacity={opacity * 2.6} />
          <stop offset="100%" stop-color={`#${color}`} stop-opacity="0" />
        </linearGradient>
      </defs>
      <!-- Trazo base: siempre visible de lado a lado -->
      <path
        d={pathLinea}
        fill="none"
        stroke={`url(#${gradId})`}
        stroke-width="2"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"
      />
      <!-- Destello que lo recorre, como el cabezal de una reproducción -->
      <path
        d={pathLinea}
        fill="none"
        stroke={`#${color}`}
        stroke-width="2.5"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"
        class="wd-traza"
        pathLength="1000"
        style={`--wd-dur: ${speed}s; opacity: ${Math.min(0.9, opacity * 4)}`}
      />
    </svg>
  )}
</div>

<style>
  /* Puntos que suben y bajan muy despacio, con una respiración de opacidad */
  .wd-particula {
    animation-name: wd-flota;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    will-change: transform, opacity;
  }

  @keyframes wd-flota {
    0%,
    100% { transform: translateY(0) scale(1); }
    50%  { transform: translateY(-14px) scale(1.35); }
  }

  /* El trazo se dibuja y se borra, como una lectura que pasa */
  /* pathLength=1000 normaliza la longitud: el destello tarda lo mismo
     independientemente de la forma que le toque a cada separador */
  .wd-traza {
    stroke-dasharray: 150 1000;
    animation: wd-recorre var(--wd-dur) linear infinite;
  }

  @keyframes wd-recorre {
    from { stroke-dashoffset: 1150; }
    to   { stroke-dashoffset: 0; }
  }

  .wd-latido {
    animation: wd-late 6s ease-in-out infinite;
  }

  @keyframes wd-late {
    0%, 100% { opacity: 0.18; transform: translate(-50%, -50%) scaleX(0.82); }
    50%      { opacity: 0.42; transform: translate(-50%, -50%) scaleX(1.05); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wd-particula,
    .wd-traza,
    .wd-latido {
      animation: none;
    }
  }
</style>

---
// Página legal de dos columnas: izquierda el texto completo (fines legales),
// derecha el resumen en lenguaje llano por sección. En móvil se apilan.
interface Section {
  title: string;
  legal: string[]; // párrafos del texto legal completo
  resumen: string; // versión corta en lenguaje llano
}

interface Props {
  title: string;
  updated: string; // "9 de julio de 2026"
  intro?: string;
  sections: Section[];
}

const { title, updated, intro, sections } = Astro.props;
---

<main class="pt-32 pb-20">
  <div class="max-w-[1100px] mx-auto px-6 md:px-10">
    <header class="mb-4">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">{title}</h1>
      <p class="text-text-tertiary text-sm">Última actualización: {updated}</p>
      {intro && <p class="text-text-secondary mt-4 max-w-3xl leading-relaxed">{intro}</p>}
    </header>

    <!-- Encabezados de columnas (solo desktop) -->
    <div class="hidden md:grid md:grid-cols-[1fr_320px] gap-8 mt-10 mb-2">
      <p class="text-xs font-bold uppercase tracking-wider text-text-tertiary">Texto completo</p>
      <p class="text-xs font-bold uppercase tracking-wider text-primary-teal">En corto</p>
    </div>

    <div class="space-y-10 mt-4 md:mt-0">
      {sections.map((s, i) => (
        <section class="md:grid md:grid-cols-[1fr_320px] gap-8 border-t border-white/10 pt-8">
          <div>
            <h2 class="text-xl font-semibold text-white mb-4">{i + 1}. {s.title}</h2>
            {s.legal.map((p) => (
              <p class="text-text-secondary leading-relaxed mb-4 text-[15px]">{p}</p>
            ))}
          </div>
          <aside class="mt-2 md:mt-0">
            <div class="rounded-xl bg-primary-teal/5 border border-primary-teal/20 p-4 md:sticky md:top-24">
              <p class="text-xs font-bold uppercase tracking-wider text-primary-teal mb-2 md:hidden">En corto</p>
              <p class="text-text-secondary text-sm leading-relaxed">{s.resumen}</p>
            </div>
          </aside>
        </section>
      ))}
    </div>

    <footer class="mt-14 border-t border-white/10 pt-8">
      <p class="text-text-tertiary text-sm">
        ¿Dudas sobre este documento? Escríbenos a
        <a href="mailto:hola@muusica.com" class="text-primary-teal hover:underline">hola@muusica.com</a>.
      </p>
    </footer>
  </div>
</main>

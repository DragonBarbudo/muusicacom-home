---
import WaveMark from './WaveMark.astro';

// ─── Reproductor del hero: fuente única de datos ───────────────────────────
// Para cambiar las canciones edita SOLO este arreglo.
//   src    → ruta del archivo en public/ (p.ej. public/audio/restaurante.mp3 → "/audio/restaurante.mp3")
//   volume → 0–100 (volumen por defecto al seleccionar ese ambiente)
//   title / artist → texto mostrado en el reproductor
// Los clips son extractos de 30s de playlists reales del catálogo (title = playlist)
const songs = [
  { ambiente: "Restaurante", title: "Amanecer Jazz",    artist: "Muusica.com", src: "/audio/restaurante.mp3", volume: 60, color: "from-primary-purple to-primary-blue" },
  { ambiente: "Cafetería",   title: "Café con Soul",    artist: "Muusica.com", src: "/audio/cafeteria.mp3",   volume: 45, color: "from-primary-teal to-primary-blue" },
  { ambiente: "Gimnasio",    title: "Salsa Clásica",    artist: "Muusica.com", src: "/audio/gimnasio.mp3",    volume: 85, color: "from-primary-blue to-primary-teal" },
  { ambiente: "Spa",         title: "Spa Relajación",   artist: "Muusica.com", src: "/audio/spa.mp3",         volume: 30, color: "from-primary-teal to-green-500" },
  { ambiente: "Tienda",      title: "Unplugged Covers", artist: "Muusica.com", src: "/audio/tienda.mp3",      volume: 60, color: "from-primary-purple to-pink-500" },
];
const ambientes = songs.map((s) => s.ambiente);
const firstSong = songs[0];
---

<section class="relative min-h-screen bg-hero-gradient overflow-hidden">
  <!-- Background decorations -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-primary-purple/20 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-1/4 left-1/4 w-80 h-80 bg-primary-blue/15 rounded-full blur-[100px]"></div>
  </div>
  
  <div class="relative max-w-[1440px] mx-auto px-4 sm:px-8 md:px-16 pt-28 sm:pt-32 pb-16 sm:pb-20 md:py-32">
    <div class="flex flex-col lg:flex-row items-center gap-8 sm:gap-16">
      <!-- Left Content -->
      <div class="flex-1 text-center lg:text-left space-y-4 sm:space-y-6 max-w-xl lg:max-w-[580px]">
        <!-- Main headline -->
        <h1 class="reveal text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-[1.15] sm:leading-tight tracking-tight">
          La música perfecta para tu negocio.
        </h1>

        <!-- Las "uu" del logo como onda: el mismo recurso que el reproductor usa
             de barra de progreso. Firma de marca, no adorno. -->
        <WaveMark
          variant="accent"
          opacity={0.6}
          fade={false}
          animate
          class="reveal mx-auto lg:mx-0 -mt-2"
        />
        
        <!-- Subheadline -->
        <p class="reveal animation-delay-100 text-base sm:text-lg md:text-xl text-text-secondary leading-relaxed px-2 sm:px-0">
          Streaming 100% legal para lugares públicos. Sin regalías, sin SACM y sin preocupaciones.
        </p>
        
        <!-- Bullet points -->
        <ul class="reveal animation-delay-200 space-y-2 sm:space-y-3 text-left mx-auto lg:mx-0 max-w-[280px] sm:max-w-none">
          <li class="flex items-center gap-2 sm:gap-3 text-text-secondary text-sm sm:text-base">
            <i data-lucide="check" class="w-4 h-4 sm:w-5 sm:h-5 text-primary-teal flex-shrink-0"></i>
            <span>Licencias comerciales incluidas</span>
          </li>
          <li class="flex items-center gap-2 sm:gap-3 text-text-secondary text-sm sm:text-base">
            <i data-lucide="check" class="w-4 h-4 sm:w-5 sm:h-5 text-primary-teal flex-shrink-0"></i>
            <span>Playlists por ambiente</span>
          </li>
          <li class="flex items-center gap-2 sm:gap-3 text-text-secondary text-sm sm:text-base">
            <i data-lucide="check" class="w-4 h-4 sm:w-5 sm:h-5 text-primary-teal flex-shrink-0"></i>
            <span>Entra y reproduce</span>
          </li>
        </ul>
        
        <!-- CTA Buttons -->
        <div class="reveal animation-delay-300 flex flex-col sm:flex-row items-center gap-3 sm:gap-4 justify-center lg:justify-start w-full sm:w-auto px-4 sm:px-0">
          <a href="https://play.muusica.com" class="btn-primary text-sm sm:text-base w-full sm:w-auto">
            <span>Probar gratis</span>
            <i data-lucide="arrow-right" class="w-4 h-4 sm:w-5 sm:h-5 ml-2"></i>
          </a>
          <a href="#beneficios" class="btn-ghost text-sm sm:text-base w-full sm:w-auto">
            <i data-lucide="play-circle" class="w-4 h-4 sm:w-5 sm:h-5 mr-2"></i>
            <span>Ver cómo funciona</span>
          </a>
        </div>
        
        <!-- Pricing microcopy -->
        <p class="reveal animation-delay-400 text-text-tertiary text-xs sm:text-sm px-4 sm:px-0">
          Desde $175 MXN/locación · 7 días gratis<br class="hidden sm:block" />
          <span class="text-text-muted block sm:inline">Sin tarjeta · Cancela cuando quieras</span>
        </p>
      </div>
      
      <!-- Right - Audio Visualization with Player -->
      <div class="flex-1 reveal-right animation-delay-200 w-full max-w-xl lg:max-w-none mt-4 sm:mt-0">
        <div class="relative h-[400px] sm:h-[500px] md:h-[600px]">
          <!-- Audio Visualization Canvas -->
          <canvas id="heroAudioViz" class="absolute inset-0 w-full h-full"></canvas>
          
          <!-- Main simulator card -->
          <!-- Sin mx-4: la tarjeta ya está centrada con left-1/2 + -translate-x-1/2,
               y el margen la corría 16px fuera del viewport en móvil -->
          <div id="musicPlayer" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-10 bg-bg-surface/90 backdrop-blur-xl rounded-2xl border border-white/10 p-4 sm:p-6 shadow-2xl w-[calc(100%-2rem)] sm:w-full max-w-sm">
            <!-- Simulator header -->
            <div class="flex items-center justify-between mb-3 sm:mb-4">
              <div class="flex items-center gap-2">
                <span class="text-text-tertiary text-xs sm:text-sm">Reproduciendo ahora</span>
                <span class="flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary-teal/20 text-primary-teal text-xs font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary-teal animate-pulse"></span>
                  EN VIVO
                </span>
              </div>
            </div>
            
            <!-- Now playing -->
            <div class="bg-white/5 rounded-xl p-3 sm:p-4 mb-3 sm:mb-4">
              <div class="flex items-center gap-3 sm:gap-4">
                <div id="albumArt" class="w-12 h-12 sm:w-14 sm:h-14 rounded-lg bg-gradient-to-br from-primary-purple to-primary-blue flex items-center justify-center flex-shrink-0">
                  <i data-lucide="disc-3" class="w-6 h-6 sm:w-8 sm:h-8 text-white animate-spin" style="animation-duration: 3s;"></i>
                </div>
                <div class="flex-1 min-w-0">
                  <p id="ambienteLabel" class="text-text-tertiary text-xs mb-1">Ambiente Restaurante</p>
                  <h4 id="songTitle" class="text-white font-medium text-sm sm:text-base truncate">Jazz Suave · Muusica.com</h4>
                  <div id="progressTrack" class="mt-2 h-1.5 bg-white/10 rounded-full overflow-hidden cursor-pointer" role="slider" aria-label="Progreso de la canción" tabindex="0">
                    <div id="progressBar" class="h-full w-0 bg-gradient-to-r from-primary-blue to-primary-teal rounded-full transition-[width] duration-150 ease-linear"></div>
                  </div>
                </div>
                <div class="flex items-center gap-1 sm:gap-2">
                  <button id="prevBtn" class="p-1.5 sm:p-2 rounded-lg bg-white/5 hover:bg-white/10 transition-colors">
                    <i data-lucide="skip-back" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-text-secondary"></i>
                  </button>
                  <button id="playPauseBtn" class="p-2.5 sm:p-3 rounded-xl bg-gradient-to-r from-primary-blue to-primary-teal hover:opacity-90 transition-opacity" aria-label="Reproducir">
                    <span data-icon="play"><i data-lucide="play" class="w-4 h-4 sm:w-5 sm:h-5 text-white"></i></span>
                    <span data-icon="pause" class="hidden"><i data-lucide="pause" class="w-4 h-4 sm:w-5 sm:h-5 text-white"></i></span>
                  </button>
                  <button id="nextBtn" class="p-1.5 sm:p-2 rounded-lg bg-white/5 hover:bg-white/10 transition-colors">
                    <i data-lucide="skip-forward" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-text-secondary"></i>
                  </button>
                </div>
              </div>
            </div>
            
            <!-- Ambiente selector -->
            <div class="mb-3 sm:mb-4">
              <p class="text-text-tertiary text-xs mb-2 sm:mb-3">Ambiente seleccionado:</p>
              <div id="ambienteButtons" class="flex flex-wrap gap-1.5 sm:gap-2">
                {ambientes.map((ambiente, i) => (
                  <button 
                    data-ambiente={ambiente}
                    class:list={[
                      "ambiente-btn px-2 sm:px-3 py-1 sm:py-1.5 rounded-full text-xs sm:text-sm font-medium transition-all",
                      i === 0 
                        ? "bg-primary-teal/20 text-primary-teal border border-primary-teal/40" 
                        : "bg-white/5 text-text-secondary border border-white/10 hover:bg-white/10"
                    ]}
                  >
                    {ambiente}
                  </button>
                ))}
              </div>
            </div>
            
            <!-- Volume & settings -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pt-3 sm:pt-4 border-t border-white/5 gap-2 sm:gap-0">
              <div class="flex items-center gap-2 sm:gap-3">
                <i data-lucide="volume-2" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-text-tertiary"></i>
                <div class="w-20 sm:w-24 h-1 bg-white/10 rounded-full overflow-hidden">
                  <div id="volumeBar" class="h-full bg-white/40 rounded-full" style={`width: ${firstSong.volume}%`}></div>
                </div>
              </div>
              <div class="flex items-center gap-2 text-text-tertiary text-xs">
                <i data-lucide="info" class="w-3 h-3 flex-shrink-0"></i>
                <span id="volumeInfo" class="text-[10px] sm:text-xs">Ambiente: Restaurante (volumen moderado)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Audio real del reproductor (mismo origen → sin problemas de CORS para Web Audio) -->
<audio id="heroAudio" preload="none" crossorigin="anonymous"></audio>
<!-- Datos de las canciones (fuente única, serializada desde el frontmatter) -->
<script type="application/json" id="heroSongs" set:html={JSON.stringify(songs)}></script>

<script is:inline>
  (function() {
    // ─── Reproductor real ──────────────────────────────────────────────
    const audio = document.getElementById('heroAudio');
    const songs = JSON.parse(document.getElementById('heroSongs').textContent || '[]');

    let currentIndex = 0;
    let isPlaying = false; // sin autoplay: el usuario presiona play
    // Compartidos con el visualizador (definido más abajo en este mismo IIFE):
    let audioCtx = null;
    let analyser = null;
    let freqData = null;

    // lucide.createIcons() sustituye cada <i data-lucide> por un <svg>, así que
    // reescribir data-lucide sobre un <i> ya sustituido no cambia nada: en su
    // lugar alternamos dos contenedores con `hidden`.
    function setPlayIcon(playing) {
      const btn = document.getElementById('playPauseBtn');
      const disc = document.querySelector('#albumArt [data-lucide], #albumArt svg');
      if (btn) {
        const p = btn.querySelector('[data-icon="play"]');
        const q = btn.querySelector('[data-icon="pause"]');
        if (p) p.classList.toggle('hidden', playing);
        if (q) q.classList.toggle('hidden', !playing);
        btn.setAttribute('aria-label', playing ? 'Pausar' : 'Reproducir');
      }
      if (disc) disc.style.animationPlayState = playing ? 'running' : 'paused';
    }

    function loadSong(index, autoplay) {
      currentIndex = (index + songs.length) % songs.length;
      const song = songs[currentIndex];
      if (!song) return;

      document.getElementById('ambienteLabel').textContent = 'Ambiente ' + song.ambiente;
      document.getElementById('songTitle').textContent = song.title + ' · ' + song.artist;
      document.getElementById('volumeInfo').textContent =
        'Ambiente: ' + song.ambiente + ' (volumen ' + song.volume + ')';

      const albumArt = document.getElementById('albumArt');
      if (albumArt) {
        albumArt.className =
          'w-12 h-12 sm:w-14 sm:h-14 rounded-lg bg-gradient-to-br ' + song.color +
          ' flex items-center justify-center flex-shrink-0';
      }

      const vol = Math.min(100, Math.max(0, song.volume == null ? 70 : song.volume));
      audio.volume = vol / 100;
      const volBar = document.getElementById('volumeBar');
      if (volBar) volBar.style.width = vol + '%';

      document.querySelectorAll('.ambiente-btn').forEach((btn, idx) => {
        btn.className = (idx === currentIndex)
          ? 'ambiente-btn px-2 sm:px-3 py-1 sm:py-1.5 rounded-full text-xs sm:text-sm font-medium transition-all bg-primary-teal/20 text-primary-teal border border-primary-teal/40'
          : 'ambiente-btn px-2 sm:px-3 py-1 sm:py-1.5 rounded-full text-xs sm:text-sm font-medium transition-all bg-white/5 text-text-secondary border border-white/10 hover:bg-white/10';
      });

      if (audio.getAttribute('src') !== song.src) audio.src = song.src;
      document.getElementById('progressBar').style.width = '0%';

      if (autoplay) play();
    }

    function ensureAudioGraph() {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (analyser || !AC) return;
      try {
        audioCtx = new AC();
        const source = audioCtx.createMediaElementSource(audio);
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 256;
        analyser.smoothingTimeConstant = 0.8;
        freqData = new Uint8Array(analyser.frequencyBinCount);
        source.connect(analyser);
        analyser.connect(audioCtx.destination);
      } catch (e) {
        analyser = null; // si falla, el visualizador usa la animación decorativa
      }
    }

    function play() {
      if (!audio.getAttribute('src')) return;
      ensureAudioGraph();
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
      const p = audio.play();
      if (p && p.catch) p.catch(() => setPlayIcon(false));
    }

    function pause() { audio.pause(); }

    function togglePlayPause() {
      if (!audio.getAttribute('src')) loadSong(currentIndex, true);
      else if (audio.paused) play();
      else pause();
    }

    const nextBtn = document.getElementById('nextBtn');
    const prevBtn = document.getElementById('prevBtn');
    const playBtn = document.getElementById('playPauseBtn');
    if (nextBtn) nextBtn.addEventListener('click', () => loadSong(currentIndex + 1, !audio.paused));
    if (prevBtn) prevBtn.addEventListener('click', () => loadSong(currentIndex - 1, !audio.paused));
    if (playBtn) playBtn.addEventListener('click', togglePlayPause);
    document.querySelectorAll('.ambiente-btn').forEach((btn, idx) => {
      btn.addEventListener('click', () => loadSong(idx, !audio.paused));
    });

    // El estado y el icono se sincronizan con los eventos reales del <audio>
    audio.addEventListener('play', () => { isPlaying = true; setPlayIcon(true); });
    audio.addEventListener('pause', () => { isPlaying = false; setPlayIcon(false); });
    audio.addEventListener('ended', () => loadSong(currentIndex + 1, true));

    // Barra de progreso real + seek
    const progressBarEl = document.getElementById('progressBar');
    const progressTrackEl = document.getElementById('progressTrack');
    audio.addEventListener('timeupdate', () => {
      if (audio.duration) progressBarEl.style.width = (audio.currentTime / audio.duration * 100) + '%';
    });
    if (progressTrackEl) {
      progressTrackEl.addEventListener('click', (e) => {
        if (!audio.duration) return;
        const rect = progressTrackEl.getBoundingClientRect();
        audio.currentTime = ((e.clientX - rect.left) / rect.width) * audio.duration;
      });
    }

    // Estado inicial: primera canción cargada, en pausa
    loadSong(0, false);
    setPlayIcon(false);
    
    // Audio Visualization
    const canvas = document.getElementById('heroAudioViz');
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    let animationId;
    let time = 0;
    
    const colors = {
      purple: '#8B5CF6',
      blue: '#3B82F6', 
      teal: '#14B8A6',
      green: '#22C55E'
    };
    
    function resize() {
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;
    }
    
    function drawOrb(x, y, radius, color, alpha = 0.3) {
      const gradient = ctx.createRadialGradient(x, y, 0, x, y, radius);
      gradient.addColorStop(0, color + Math.floor(alpha * 255).toString(16).padStart(2, '0'));
      gradient.addColorStop(0.5, color + Math.floor(alpha * 0.5 * 255).toString(16).padStart(2, '0'));
      gradient.addColorStop(1, color + '00');
      
      ctx.beginPath();
      ctx.arc(x, y, radius, 0, Math.PI * 2);
      ctx.fillStyle = gradient;
      ctx.fill();
    }
    
    function drawRing(x, y, radius, color, lineWidth = 1, alpha = 0.2) {
      ctx.beginPath();
      ctx.arc(x, y, radius, 0, Math.PI * 2);
      ctx.strokeStyle = color + Math.floor(alpha * 255).toString(16).padStart(2, '0');
      ctx.lineWidth = lineWidth;
      ctx.stroke();
    }
    
    function drawParticle(x, y, size, color, alpha = 1) {
      ctx.beginPath();
      ctx.arc(x, y, size, 0, Math.PI * 2);
      ctx.fillStyle = color + Math.floor(alpha * 255).toString(16).padStart(2, '0');
      ctx.shadowBlur = 15;
      ctx.shadowColor = color;
      ctx.fill();
      ctx.shadowBlur = 0;
    }
    
    function drawSpectrumBar(x, y, width, height, color) {
      const gradient = ctx.createLinearGradient(x, y, x, y - height);
      gradient.addColorStop(0, color + 'FF');
      gradient.addColorStop(0.5, color + '80');
      gradient.addColorStop(1, color + '40');
      
      ctx.fillStyle = gradient;
      ctx.fillRect(x, y - height, width, height);
      
      // Top glow
      ctx.beginPath();
      ctx.arc(x + width/2, y - height, width/2, 0, Math.PI * 2);
      ctx.fillStyle = color + '60';
      ctx.shadowBlur = 10;
      ctx.shadowColor = color;
      ctx.fill();
      ctx.shadowBlur = 0;
    }
    
    function animate() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      time += 0.016;

      // Datos del audio real (si está sonando y el analizador está conectado)
      let audioLevels = null;
      if (analyser && freqData && !audio.paused) {
        analyser.getByteFrequencyData(freqData);
        audioLevels = freqData;
      }

      // Center the visualization
      const centerX = canvas.width / 2;
      const centerY = canvas.height / 2;
      
      // Scale factor based on canvas size
      const scale = Math.min(canvas.width, canvas.height) / 600;
      
      // Draw background orbs (pulsing to beat)
      let beatIntensity;
      if (audioLevels) {
        let sum = 0;
        for (let k = 0; k < audioLevels.length; k++) sum += audioLevels[k];
        beatIntensity = (sum / audioLevels.length) / 255;
      } else {
        beatIntensity = !audio.paused ? (Math.sin(time * 3) + 1) / 2 : 0.3;
      }
      const pulseRadius = (150 + beatIntensity * 30) * scale;
      
      // Main central orbs - larger and more visible
      drawOrb(centerX, centerY, pulseRadius, colors.purple, 0.25);
      drawOrb(centerX, centerY, pulseRadius * 0.7, colors.blue, 0.2);
      drawOrb(centerX, centerY, pulseRadius * 0.4, colors.teal, 0.3);
      drawOrb(centerX, centerY, pulseRadius * 0.2, colors.green, 0.4);
      
      // Concentric rings (pulsing) - more rings, larger
      const rings = [
        { radius: (200 + beatIntensity * 20) * scale, color: colors.purple, width: 2, alpha: 0.2 },
        { radius: (250 + beatIntensity * 15) * scale, color: colors.blue, width: 1.5, alpha: 0.15 },
        { radius: (300 + beatIntensity * 10) * scale, color: colors.teal, width: 1, alpha: 0.12 },
        { radius: 350 * scale, color: colors.purple, width: 1, alpha: 0.08 },
        { radius: 400 * scale, color: colors.blue, width: 0.5, alpha: 0.05 },
      ];
      
      rings.forEach(ring => {
        drawRing(centerX, centerY, ring.radius, ring.color, ring.width, ring.alpha);
      });
      
      // Audio spectrum bars - positioned below center
      const numBars = 20;
      const barWidth = 10 * scale;
      const barSpacing = 6 * scale;
      const startX = centerX - (numBars * (barWidth + barSpacing)) / 2;
      const baseY = centerY + (200 * scale);
      
      for (let i = 0; i < numBars; i++) {
        const barX = startX + i * (barWidth + barSpacing);
        
        // Altura de cada barra: datos reales del audio si los hay; si no, animación decorativa
        let barHeight = 40 * scale;
        if (audioLevels) {
          const v = audioLevels[Math.floor((i / numBars) * audioLevels.length)] / 255;
          barHeight = (15 + v * 200) * scale;
        } else if (!audio.paused) {
          barHeight += Math.sin(time * 4 + i * 0.5) * 30 * scale +
                       Math.sin(time * 7 + i * 0.8) * 20 * scale +
                       Math.sin(time * 2 + i * 0.3) * 15 * scale +
                       (beatIntensity * 40 * scale);
        }
        
        const color = i < numBars / 3 ? colors.purple : 
                     i < (numBars * 2) / 3 ? colors.blue : colors.teal;
        
        drawSpectrumBar(barX, baseY, barWidth, Math.max(15 * scale, barHeight), color);
      }
      
      // Floating particles - more particles, larger area
      const particleConfigs = [
        { x: -200, y: -150, size: 4, color: colors.purple, speed: 0.8, offset: 0 },
        { x: -180, y: 100, size: 3, color: colors.blue, speed: 0.6, offset: 1 },
        { x: 200, y: -120, size: 3.5, color: colors.teal, speed: 0.7, offset: 2 },
        { x: 220, y: 80, size: 3, color: colors.purple, speed: 0.5, offset: 3 },
        { x: -120, y: -200, size: 3, color: colors.blue, speed: 0.9, offset: 4 },
        { x: 150, y: 180, size: 4, color: colors.teal, speed: 0.6, offset: 5 },
        { x: -250, y: -50, size: 3, color: colors.green, speed: 0.7, offset: 6 },
        { x: 100, y: -220, size: 3.5, color: colors.purple, speed: 0.8, offset: 7 },
        { x: -80, y: 200, size: 3, color: colors.blue, speed: 0.5, offset: 8 },
        { x: 220, y: -80, size: 4, color: colors.teal, speed: 0.6, offset: 9 },
        { x: -150, y: 50, size: 2.5, color: colors.green, speed: 0.7, offset: 10 },
        { x: 180, y: -180, size: 3, color: colors.purple, speed: 0.8, offset: 11 },
      ];
      
      particleConfigs.forEach(p => {
        const floatY = Math.sin(time * p.speed + p.offset) * 20;
        const floatX = Math.cos(time * p.speed * 0.5 + p.offset) * 12;
        drawParticle(centerX + (p.x * scale) + floatX, centerY + (p.y * scale) + floatY, p.size * scale, p.color, 0.9);
      });
      
      // Small sparkles orbiting the main orb
      if (isPlaying) {
        for (let i = 0; i < 12; i++) {
          const angle = (time * 0.5 + i * (Math.PI * 2) / 12);
          const distance = (180 + Math.sin(time * 2 + i) * 30) * scale;
          const sx = centerX + Math.cos(angle) * distance;
          const sy = centerY + Math.sin(angle) * distance;
          const size = (2 + Math.sin(time * 3 + i) * 0.8) * scale;
          
          drawParticle(sx, sy, size, colors.teal, 0.8);
        }
      }
      
      animationId = requestAnimationFrame(animate);
    }
    
    window.addEventListener('resize', () => {
      resize();
    });
    
    // Intersection Observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          if (!animationId) {
            resize();
            animate();
          }
        } else {
          if (animationId) {
            cancelAnimationFrame(animationId);
            animationId = null;
          }
        }
      });
    }, { threshold: 0.1 });
    
    observer.observe(canvas);
    
    resize();
    animate();
  })();
</script>

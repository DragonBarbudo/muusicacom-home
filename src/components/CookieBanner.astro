---
// Aviso de cookies mínimo: una tarjeta discreta abajo a la izquierda,
// se acepta una vez (localStorage) y no vuelve a aparecer. No bloquea nada.
---

<div
  id="cookieBanner"
  class="hidden fixed bottom-4 left-4 right-4 sm:right-auto sm:max-w-sm z-40 rounded-xl border border-white/10 bg-bg-surface/95 backdrop-blur-md shadow-2xl p-4"
>
  <p class="text-text-secondary text-xs leading-relaxed mb-3">
    Usamos cookies esenciales y de medición anónima para que el sitio funcione y mejorar tu experiencia.
    <a href="/aviso-de-privacidad" class="text-primary-teal hover:underline">Más información en el aviso de privacidad</a>.
  </p>
  <button
    id="cookieAcceptBtn"
    class="text-xs font-semibold px-4 py-2 rounded-lg bg-primary-teal/20 text-primary-teal border border-primary-teal/40 hover:bg-primary-teal/30 transition-colors"
  >
    Entendido
  </button>
</div>

<script is:inline>
  (function () {
    var KEY = 'muusica-cookies-ok';
    try {
      if (localStorage.getItem(KEY)) return;
    } catch (e) { return; } // sin localStorage (modo privado estricto): no insistimos
    var banner = document.getElementById('cookieBanner');
    var btn = document.getElementById('cookieAcceptBtn');
    if (!banner || !btn) return;
    banner.classList.remove('hidden');
    btn.addEventListener('click', function () {
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
      banner.remove();
    });
  })();
</script>

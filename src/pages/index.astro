---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Catalog from '../components/Catalog.astro';
import VisualizerShowcase from '../components/VisualizerShowcase.astro';
import MoodModeShowcase from '../components/MoodModeShowcase.astro';
import BusinessTypes from '../components/BusinessTypes.astro';
import WhyNotSpotify from '../components/WhyNotSpotify.astro';
import LegalTrust from '../components/LegalTrust.astro';
import Comparativa from '../components/Comparativa.astro';
import Pricing from '../components/Pricing.astro';
import Blog from '../components/Blog.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import WaveDivider from '../components/WaveDivider.astro';
---

<Layout
  title="Música legal para tu negocio | Muusica.com"
  description="Streaming legal para restaurantes, cafeterías, gimnasios y tiendas en México. Licencia comercial incluida desde $175 MXN al mes. 7 días gratis."
>
  <Header transparent={true} />
  <main>
    <Hero />
    <TrustBadges />
    <WaveDivider tipo="linea" height="70px" color="14B8A6" opacity={0.16} space="py-12" seed={1} />
    <HowItWorks />
    <WaveDivider tipo="onda" height="64px" color="14B8A6" opacity={0.13} direction="right" space="py-14" seed={2} />
    <Catalog />
    <WaveDivider tipo="particulas" height="34px" color="3B82F6" opacity={0.18} space="py-16" seed={3} />
    <VisualizerShowcase />
    <WaveDivider tipo="pulso" height="46px" color="8B5CF6" opacity={0.2} space="py-16" seed={4} />
    <MoodModeShowcase />
    <WaveDivider tipo="onda" height="30px" color="14B8A6" opacity={0.16} space="py-10" seed={5} />
    <BusinessTypes />
    <WaveDivider tipo="linea" height="56px" color="3B82F6" opacity={0.18} space="py-12" seed={6} />
    <WhyNotSpotify />
    <WaveDivider tipo="onda" height="76px" color="14B8A6" opacity={0.12} direction="right" space="py-14" seed={7} />
    <LegalTrust />
    <WaveDivider tipo="particulas" height="40px" color="14B8A6" opacity={0.14} space="py-16" seed={8} />
    <Comparativa />
    <WaveDivider tipo="linea" height="64px" color="8B5CF6" opacity={0.2} space="py-12" seed={9} />
    <Pricing />
    <WaveDivider tipo="onda" height="44px" color="14B8A6" opacity={0.15} space="py-12" seed={10} />
    <Blog />
    <WaveDivider tipo="pulso" height="38px" color="3B82F6" opacity={0.18} space="py-16" seed={11} />
    <FAQ />
    <WaveDivider tipo="onda" height="60px" color="14B8A6" opacity={0.13} direction="right" space="py-14" seed={12} />
    <FinalCTA />
  </main>
  <Footer />
</Layout>

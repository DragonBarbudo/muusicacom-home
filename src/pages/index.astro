---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Catalog from '../components/Catalog.astro';
import VisualizerShowcase from '../components/VisualizerShowcase.astro';
import MoodModeShowcase from '../components/MoodModeShowcase.astro';
import BusinessTypes from '../components/BusinessTypes.astro';
import WhyNotSpotify from '../components/WhyNotSpotify.astro';
import LegalTrust from '../components/LegalTrust.astro';
import Pricing from '../components/Pricing.astro';
import Blog from '../components/Blog.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Muusica.com — Música legal para tu negocio, sin regalías ni SACM"
  description="Streaming de música 100% legal para restaurantes, cafeterías, gimnasios, hoteles y tiendas en México. Licencia comercial incluida desde $175 MXN/mes. Prueba 7 días gratis."
>
  <Header transparent={true} />
  <main>
    <Hero />
    <TrustBadges />
    <HowItWorks />
    <Catalog />
    <VisualizerShowcase />
    <MoodModeShowcase />
    <BusinessTypes />
    <WhyNotSpotify />
    <LegalTrust />
    <Pricing />
    <Blog />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
